# 本地开发示例。复制为 .env 后可修改端口和凭证。
BACKEND_PORT=8080
VUE_PORT=8088
REACT_PORT=8089

MYSQL_PORT=3306
MYSQL_DATABASE=app
MYSQL_USER=app
MYSQL_PASSWORD=local_mysql_app
MYSQL_ROOT_PASSWORD=local_mysql_root

POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=local_postgres_app

REDIS_PORT=6379

# 演示账号固定为 admin 和 analyst，可修改本地密码。
DEMO_ADMIN_PASSWORD=local-admin
DEMO_ANALYST_PASSWORD=local-analyst
# PostgreSQL 本地启动时创建缺失的演示账号。
DEMO_ACCOUNTS_ENABLED=true
DETECTION_TRANSPORT=http
ONNX_CPU=false

MONGO_PORT=27017
MONGO_USER=root
MONGO_PASSWORD=local_mongo_root

# 巡检平台。用文件 .env.blade 保存实际值，运行时传入 --env-file .env.blade。
BLADE_DB_PASSWORD=
BLADE_ADMIN_PASSWORD=
BLADE_DATA_DIR=./blade-data
BLADE_MODEL_DIR=./blade-models
BLADE_BIND_ADDRESS=127.0.0.1
BLADE_WEB_PORT=8090
BLADE_MAX_UPLOAD_BYTES=10000000000
BLADE_MAX_EXPANDED_BYTES=30000000000
