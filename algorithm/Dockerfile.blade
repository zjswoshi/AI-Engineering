FROM python:3.12-slim
COPY --from=ghcr.io/astral-sh/uv:0.12.15 /uv /bin/uv
ARG BLADE_ORT_EXTRA=onnx
ENV PYTHONUNBUFFERED=1 UV_NO_DEV=1 PATH=/app/.venv/bin:$PATH \
    BLADE_FONT_PATH=/usr/share/fonts/truetype/wqy/wqy-zenhei.ttc
WORKDIR /app
RUN sed -i 's|http://deb.debian.org|https://deb.debian.org|g' /etc/apt/sources.list.d/debian.sources \
    && apt-get -o Acquire::Retries=2 update && apt-get -o Acquire::Retries=2 install -y --no-install-recommends fonts-wqy-zenhei \
    && rm -rf /var/lib/apt/lists/*
COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv uv sync --locked --extra http --extra blade --extra "$BLADE_ORT_EXTRA"
COPY starter_algorithm ./starter_algorithm
USER 10001:10001
CMD ["uvicorn", "starter_algorithm.blade_http:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--no-access-log"]
